# ============================================
# GridWise Environment Configuration
# Copy this file to .env and fill real values
# ============================================

# ---------- App ----------
APP_NAME=GridWise
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- LLM Provider ----------
# Options: openai | groq | gemini | openai_compatible
LLM_PROVIDER=openai

# API key for your chosen provider
LLM_API_KEY=sk-your-key-here

# Base URL (leave default for OpenAI, change for Groq/Gemini)
# OpenAI:  https://api.openai.com/v1
# Groq:    https://api.groq.com/openai/v1
# Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=https://api.openai.com/v1

# Model identifier
# OpenAI:  gpt-4o-mini
# Groq:    llama-3.3-70b-versatile
# Gemini:  gemini-1.5-flash
LLM_MODEL=gpt-4o-mini

# LLM call settings
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0

# ---------- Optimizer ----------
OPTIMIZER_TIME_LIMIT_SECONDS=10

# ---------- Safety ----------
# Never commit real .env values